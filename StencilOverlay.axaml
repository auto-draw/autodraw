<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Autodraw.StencilOverlay"
        SystemDecorations="None" ShowInTaskbar="False" Topmost="True"
        CanResize="False" Background="Transparent" TransparencyLevelHint="Transparent"
        IsHitTestVisible="False">
  <Image x:Name="StencilImage" Stretch="Fill"/>
</Window>
